<resources>
    <!-- SCT21 は音声通話の機能を持たず、モバイル回線をデータ通信のみに使う。 -->
    <bool name="config_voice_capable">false</bool>

    <!-- 指紋の HAL は HIDL の 2.1 であり、Android 12 以降のフレームワークはこの宣言がなければ HAL を探さない。
         書式は ID:種別:強度であり、2 は指紋、15 は Strong を表す。 -->
    <string-array name="config_biometric_sensors" translatable="false">
        <item>0:2:15</item>
    </string-array>
    <!-- 自動調整の照度（lux）とバックライトの値の対応表。純正の framework-res の値である。この表がなければ
         フレームワークは自動調整のコントローラを作らず、照度センサーの値を明るさへ反映しない。 -->
    <integer-array name="config_autoBrightnessLevels">
        <item>15</item>
        <item>150</item>
        <item>1000</item>
        <item>5000</item>
    </integer-array>
    <integer-array name="config_autoBrightnessLcdBacklightValues">
        <item>10</item>
        <item>68</item>
        <item>135</item>
        <item>154</item>
        <item>255</item>
    </integer-array>
</resources>
